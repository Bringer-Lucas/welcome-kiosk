# Copy to .env.local for local dev. On Railway these are set as service variables.

# Postgres. Railway injects DATABASE_URL automatically once you attach a
# Postgres service to the app service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/welcome

# Shared secret the reception PC's print agent uses to claim print jobs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINT_AGENT_TOKEN=

# --- Stubbed until IT delivers. Leave blank and the app logs instead of calling out. ---

# Microsoft Entra ID app registration (User.Read.All, application permission).
# Open question 6 in Notes/04-open-questions.md.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Power Automate flow HTTP trigger URL (Teams DM + email to the host).
# Open question 7 in Notes/04-open-questions.md.
POWER_AUTOMATE_WEBHOOK_URL=

# Visitor photo retention. Open question 8 — defaulting to 90 days.
PHOTO_RETENTION_DAYS=90
